generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════════════════════

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  CONTRIBUTOR
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
}

enum RegistrationStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  WAITING_LIST
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIAL
}

enum Y2CMemberStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  PENDING
}

enum EventType {
  TRAINING
  CONFERENCE
  WORKSHOP
  MEETUP
  TEAM_SETUP
  THREE_S
  TEAM_REALIZE
  COFFREDAY
  HACKATHON
  OTHER
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ON_HOLD
  CANCELLED
  EVALUATING
}

enum NotificationType {
  REGISTRATION
  PAYMENT
  EVENT
  SYSTEM
  PROMOTION
  REMINDER
}

enum ActivityType {
  LOGIN
  LOGOUT
  REGISTER
  CREATE
  UPDATE
  DELETE
  PUBLISH
  IMPORT
  EXPORT
}

enum ExportFormat {
  CSV
  EXCEL
  PDF
}

enum ExportType {
  FORMATIONS
  INSCRIPTIONS
  PAIEMENTS
  MEMBRES_Y2C
  ARTICLES
  PROJETS
  UTILISATEURS
  RECRUTEMENTS
  CANDIDATURES
  CONTACTS
}

enum ExportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

// ═══════════════════════════════════════════════════════════════
// MODELS
// ═══════════════════════════════════════════════════════════════

model ActivityLog {
  id         String       @id @default(cuid())
  userId     String
  action     ActivityType
  resource   String
  resourceId String?
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime     @default(now())
  User       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@index([action])
  @@map("activity_logs")
}

model Article {
  id             String           @id @default(cuid())
  title          String
  slug           String           @unique
  content        String
  excerpt        String?
  featuredImage  String?
  authorId       String
  category       String
  tags           String[]
  status         ArticleStatus    @default(DRAFT)
  publishedAt    DateTime?
  views          Int              @default(0)
  isFeatured     Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  User           User             @relation(fields: [authorId], references: [id], onDelete: SetNull)
  ArticleComment ArticleComment[]

  @@index([authorId])
  @@index([status])
  @@index([slug])
  @@index([createdAt])
  @@map("articles")
}

model ArticleComment {
  id                   String           @id @default(cuid())
  articleId            String
  authorName           String
  authorEmail          String
  content              String
  isApproved           Boolean          @default(false)
  parentId             String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  Article              Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  ArticleComment       ArticleComment?  @relation("ArticleCommentToArticleComment", fields: [parentId], references: [id])
  other_ArticleComment ArticleComment[] @relation("ArticleCommentToArticleComment")

  @@index([articleId])
  @@index([parentId])
  @@index([isApproved])
  @@map("article_comments")
}

model Candidature {
  id            String       @id @default(cuid())
  recruitmentId String
  userId        String?
  fullName      String
  email         String
  phone         String
  cvUrl         String
  coverLetter   String?
  status        String       @default("PENDING")
  notes         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  Recruitment   Recruitment  @relation(fields: [recruitmentId], references: [id], onDelete: Cascade)
  User          User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  Evaluation    Evaluation[]
  Interview     Interview[]

  @@index([recruitmentId])
  @@index([email])
  @@index([status])
  @@index([userId])
  @@map("candidatures")
}

model ContactMessage {
  id           String    @id @default(cuid())
  name         String
  email        String
  subject      String
  message      String
  isRead       Boolean   @default(false)
  repliedAt    DateTime?
  repliedBy    String?
  replyContent String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
  @@index([isRead])
  @@index([createdAt])
  @@map("contact_messages")
}

model Evaluation {
  id            String      @id @default(cuid())
  candidatureId String
  evaluatorId   String
  criteria      String
  score         Int
  comments      String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Candidature   Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)
  User          User        @relation(fields: [evaluatorId], references: [id], onDelete: SetNull)

  @@index([candidatureId])
  @@index([evaluatorId])
  @@map("evaluations")
}

model Event {
  id                String              @id @default(cuid())
  title             String
  slug              String              @unique
  description       String
  eventType         EventType
  startDate         DateTime
  endDate           DateTime
  time              String
  location          String
  maxAttendees      Int?
  isPaid            Boolean             @default(false)
  price             Float?
  imageUrl          String?
  isPublished       Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  EventRegistration EventRegistration[]

  @@index([slug])
  @@index([eventType])
  @@index([startDate])
  @@index([isPublished])
  @@map("events")
}

model EventRegistration {
  id        String   @id @default(cuid())
  eventId   String
  name      String
  email     String
  phone     String
  status    String   @default("PENDING")
  attended  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  Event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([email])
  @@index([status])
  @@map("event_registrations")
}

model File {
  id        String   @id @default(cuid())
  name      String
  mimeType  String
  size      Int
  url       String
  publicId  String   @unique
  format    String?
  width     Int?
  height    Int?
  userId    String
  folder    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([publicId])
  @@map("files")
}

model Formation {
  id               String             @id @default(cuid())
  title            String
  slug             String             @unique
  description      String
  objectives       String?
  prerequisites    String?
  duration         String
  level            String
  price            Float?
  category         String
  imageUrl         String?
  isPublished      Boolean            @default(false)
  maxParticipants  Int?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  FormationSession FormationSession[]
  Registration     Registration[]

  @@index([slug])
  @@index([category])
  @@index([isPublished])
  @@index([level])
  @@map("formations")
}

model FormationSession {
  id                  String         @id @default(cuid())
  formationId         String
  startDate           DateTime
  endDate             DateTime
  location            String
  maxParticipants     Int
  currentParticipants Int            @default(0)
  status              String         @default("SCHEDULED")
  price               Float?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  Formation           Formation      @relation(fields: [formationId], references: [id], onDelete: Cascade)
  Registration        Registration[]

  @@index([formationId])
  @@index([startDate])
  @@index([status])
  @@map("formation_sessions")
}

model Interview {
  id            String      @id @default(cuid())
  candidatureId String
  scheduledAt   DateTime
  interviewer   String
  notes         String?
  status        String      @default("SCHEDULED")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  Candidature   Candidature @relation(fields: [candidatureId], references: [id], onDelete: Cascade)

  @@index([candidatureId])
  @@index([status])
  @@map("interviews")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  User      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([type])
  @@map("notifications")
}

model Partner {
  id           String   @id @default(cuid())
  name         String
  logo         String?
  website      String?
  description  String?
  email        String?
  phone        String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive])
  @@index([displayOrder])
  @@map("partners")
}

model Payment {
  id               String        @id @default(cuid())
  registrationId   String?
  y2cMemberId      String?
  amount           Float
  currency         String        @default("MGA")
  paymentMethod    String
  paymentReference String
  status           PaymentStatus @default(PENDING)
  metadata         Json?
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime? 
  Registration     Registration? @relation(fields: [registrationId], references: [id])
  Y2CMember        Y2CMember?    @relation(fields: [y2cMemberId], references: [id])

  @@index([paymentReference])
  @@index([status])
  @@index([registrationId])
  @@index([y2cMemberId])
  @@index([createdAt])
  @@map("payments")
}

model Project {
  id            String          @id @default(cuid())
  title         String
  slug          String          @unique
  description   String
  objectives    String?
  impact        String?
  technologies  String[]
  images        String[]
  year          Int
  category      String
  isFeatured    Boolean         @default(false)
  status        ProjectStatus   @default(PLANNING)
  client        String?
  projectUrl    String?
  githubUrl     String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  ProjectMetric ProjectMetric[]
  User          User[]          @relation("UserProjects")

  @@index([slug])
  @@index([year])
  @@index([category])
  @@index([status])
  @@map("projects")
}

model ProjectMetric {
  id          String   @id @default(cuid())
  projectId   String
  metricKey   String
  metricValue String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@map("project_metrics")
}

model Recruitment {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  description  String
  requirements String
  department   String
  position     String
  isActive     Boolean       @default(true)
  deadline     DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  Candidature  Candidature[]

  @@index([slug])
  @@index([department])
  @@index([isActive])
  @@index([deadline])
  @@map("recruitments")
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("refresh_tokens")
}

model Registration {
  id               String             @id @default(cuid())
  sessionId        String
  formationId      String?
  firstName        String
  lastName         String
  email            String
  phone            String
  motivation       String?
  status           RegistrationStatus @default(PENDING)
  paymentStatus    PaymentStatus      @default(PENDING)
  paymentAmount    Float?
  paymentReference String?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  Payment          Payment[]
  Formation        Formation?         @relation(fields: [formationId], references: [id])
  FormationSession FormationSession   @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([formationId])
  @@index([email])
  @@index([status])
  @@map("registrations")
}

model Setting {
  id          String   @id @default(cuid())
  key         String   @unique
  group       String   // par ex. 'general', 'security', 'email', 'public'
  value       Json     // stocke les paramètres sous forme d'objet JSON
  label       String?  // nom lisible pour l'UI
  description String?  // aide contextuelle
  isPublic    Boolean  @default(false) // accessible sans authentification
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  // Index pour les recherches fréquentes
  @@index([group])
  @@index([key])
  @@index([isPublic])
  @@unique([group, key]) // (optionnel) empêche les doublons au sein d'un groupe
  @@map("settings")      // nom de la table en base
}

model TeamMember {
  id           String   @id @default(cuid())
  userId       String   @unique
  role         String
  department   String
  bio          String?
  photoUrl     String?
  linkedin     String?
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([department])
  @@index([isActive])
  @@map("team_members")
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  password_hash String
  firstName     String
  lastName      String
  role          Role           @default(VIEWER)
  status        UserStatus     @default(PENDING)
  phone         String?
  avatar        String?
  bio           String?
  isActive      Boolean        @default(true)
  lastLogin     DateTime?
  emailVerified DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ActivityLog   ActivityLog[]
  Article       Article[]
  Candidature   Candidature[]
  Evaluation    Evaluation[]
  File          File[]
  Notification  Notification[]
  RefreshToken  RefreshToken[]
  TeamMember    TeamMember?
  Project       Project[]      @relation("UserProjects")
  ExportHistory ExportHistory[] @relation("UserExports")

  @@index([email])
  @@index([role])
  @@index([status])
  @@map("users")
}

model Y2CEvent {
  id                   String                 @id @default(cuid())
  title                String
  slug                 String                 @unique
  description          String
  eventType            EventType
  startDate            DateTime
  endDate              DateTime
  location             String
  maxParticipants      Int?
  isPaid               Boolean                @default(false)
  price                Float?
  imageUrl             String?
  isPublished          Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  Y2CEventRegistration Y2CEventRegistration[]

  @@index([slug])
  @@index([eventType])
  @@index([startDate])
  @@index([isPublished])
  @@map("y2c_events")
}

model Y2CEventRegistration {
  id          String   @id @default(cuid())
  eventId     String
  name        String
  email       String
  phone       String
  studentId   String?
  institution String?
  status      String   @default("PENDING")
  attended    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  Y2CEvent    Y2CEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([email])
  @@index([status])
  @@map("y2c_event_registrations")
}

model Y2CMember {
  id                String          @id @default(cuid())
  name              String
  email             String          @unique
  phone             String
  studentId         String?
  institution       String?
  membershipFeePaid Float?
  badgeNumber       String          @unique
  status            Y2CMemberStatus @default(PENDING)
  joinedAt          DateTime        @default(now())
  expiresAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  Payment           Payment[]

  @@index([email])
  @@index([badgeNumber])
  @@index([status])
  @@map("y2c_members")
}

model ExportHistory {
  id          String       @id @default(cuid())
  type        ExportType
  format      ExportFormat
  filters     Json?
  fileName    String
  fileUrl     String?
  fileSize    Int?
  status      ExportStatus @default(PENDING)
  error       String?
  requestedBy String
  createdAt   DateTime     @default(now())
  completedAt DateTime?
  User        User         @relation("UserExports", fields: [requestedBy], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([createdAt])
  @@index([requestedBy])
  @@map("export_histories")
}